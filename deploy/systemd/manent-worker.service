# manent worker: runs the deploys from the queue.
# Installation: docs/content/operazioni/installazione.md
[Unit]
Description=manent worker
Documentation=https://github.com/joeg-ita/manent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=manent
Group=manent
# DBOS_SYSTEM_DATABASE_URL and any secrets (CONSUL_HTTP_TOKEN, ...).
EnvironmentFile=/etc/manent/manent.env
Environment=MANENT_CONFIG=/etc/manent/manent.yml
ExecStart=/usr/local/bin/manent-server worker
WorkingDirectory=/var/lib/manent
# On shutdown the worker stops dequeuing deploys and waits for the running ones for
# dbos.drain_timeout: the systemd timeout must exceed it.
TimeoutStopSec=6min
KillSignal=SIGTERM
Restart=on-failure
RestartSec=5s
# executor_id = hostname (default): it must stay the same across restarts.
StateDirectory=manent
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/manent /var/log/manent
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
