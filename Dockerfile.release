# Immagine del server nei rilasci (GoReleaser): usa i binari già compilati per la piattaforma.
# Helm serve solo per "helm template" nel plugin kubernetes (immagine multi-architettura).
FROM alpine/helm:4.3.0 AS helm

FROM gcr.io/distroless/static-debian12:nonroot
ARG TARGETPLATFORM
COPY ${TARGETPLATFORM}/manent-server ${TARGETPLATFORM}/manent ${TARGETPLATFORM}/manent-plugin-remote-copy /usr/local/bin/
COPY --from=helm /usr/bin/helm /usr/local/bin/helm
WORKDIR /var/lib/manent
ENV MANENT_CONFIG=/etc/manent/manent.yml
EXPOSE 8080 9090
USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/manent-server"]
CMD ["serve"]
