{
  "name": "manent-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Interfaccia web di manent, incorporata in manent-server (internal/webui).",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts",
    "check:api": "openapi-typescript ../api/openapi.yaml -o /tmp/manent-schema.d.ts && diff -q /tmp/manent-schema.d.ts src/api/schema.d.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.1.0",
    "@fontsource-variable/jetbrains-mono": "5.1.1",
    "@fontsource/space-grotesk": "5.1.0",
    "@radix-ui/react-dialog": "1.1.2",
    "@tanstack/react-query": "5.62.7",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "oidc-client-ts": "3.1.0",
    "openapi-fetch": "0.13.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "recharts": "2.15.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.20",
    "jsdom": "25.0.1",
    "openapi-typescript": "7.4.4",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  }
}
